{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"env": {
		"DISABLE_TELEMETRY": "1",
		"DISABLE_ERROR_REPORTING": "1",
		"DISABLE_FEEDBACK_COMMAND": "1",
		"CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
	},
	"enableAllProjectMcpServers": true,
	"permissions": {
		"disableBypassPermissionsMode": "disable",
		"deny": [
			"Read(**/.env)",
			"Read(**/.env.local)",
			"Read(**/.env.localhost)",
			"Read(**/.env.develop)",
			"Read(**/.env.staging)",
			"Read(**/.env.production)",
			"Read(**/.env.bak)",
			"Read(**/credentials.json)",
			"Read(**/credentials/**)",
			"Read(**/GoogleService-Info.plist)",
			"Read(**/google-services.json)",
			"Read(**/.npmrc)",
			"Read(**/*.pem)",
			"Read(**/*.key)",
			"Read(**/*.p8)",
			"Read(**/*.p12)",
			"Read(**/*.jks)",
			"Read(**/*.keystore)",
			"Read(**/certs/**)",
			"Read(**/.db_data/**)",
			"Read(**/.appsmith_stacks/**)",
			"Read(~/.ssh/**)",
			"Read(~/.claude/.credentials.json)",
			"Read(~/.sportup/**)",
			"mcp__stripe__send_money",
			"mcp__stripe__transfer_money",
			"mcp__stripe__convert_currency",
			"mcp__stripe__setup_recipient",
			"mcp__stripe__atlas_company_formation",
			"mcp__stripe__send_stripe_feedback",
			"Edit(**/generated/**)",
			"Edit(**/dist/**)",
			"Edit(**/node_modules/**)",
			"Edit(**/.claude/rules/**)",
			"Edit(**/.claude/skills/**)",
			"Edit(**/.claude/settings.json)",
			"Edit(**/package-lock.json)",
			"Bash(git push --force *)",
			"Bash(git push -f *)",
			"Bash(printenv *)",
			"PowerShell(git push --force *)",
			"PowerShell(git push -f *)",
			"PowerShell(Get-ChildItem env:*)"
		],
		"ask": [
			"mcp__stripe__stripe_api_write",
			"mcp__expo__*",
			"Bash(git commit *)",
			"Bash(git push *)",
			"Bash(git merge *)",
			"Bash(git rebase *)",
			"Bash(git tag *)",
			"Bash(git reset --hard *)",
			"Bash(npm publish *)",
			"Bash(npm version *)",
			"Bash(npm run release *)",
			"Bash(npm run reset:local *)",
			"Bash(eas *)",
			"Bash(npx eas *)",
			"PowerShell(git commit *)",
			"PowerShell(git push *)",
			"PowerShell(git merge *)",
			"PowerShell(git rebase *)",
			"PowerShell(git reset --hard *)",
			"PowerShell(npm publish *)",
			"PowerShell(npm version *)",
			"PowerShell(npm run reset:local *)"
		]
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash|PowerShell|Read|Grep|Edit|Write|MultiEdit|NotebookEdit",
				"hooks": [{"type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.agents/scripts/guard.mjs", "pre"], "timeout": 10}]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Edit|Write|MultiEdit|NotebookEdit",
				"hooks": [{"type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.agents/scripts/guard.mjs", "post"], "timeout": 10}]
			}
		],
		"Stop": [
			{
				"hooks": [{"type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.agents/scripts/guard.mjs", "stop"], "timeout": 300}]
			}
		]
	}
}
